# Shared container metadata
IMAGE_FULL=registry.gitlab.com/your-group/cc-app-backend:latest
CI_PROJECT_NAME=cc-backend-monolitic
API_DOMAIN=api.example.com

# Dev
APP_PORT=8080
DATABASE_URL=postgres-host
DATABASE_USER=cc_app
DATABASE_PASSWORD=<set-strong-db-password>
DATABASE_NAME=cc_app_db

# Security
INTERNAL_API_KEY=<set-internal-api-key>
JAWUPAY_HMAC_SECRET=<set-jawupay-hmac-secret>
JAWUPAY_WEBHOOK_ALLOWED_IPS=161.97.149.232
JWT_SECRET=<set-app-jwt-secret>
ADMIN_JWT_SECRET=<set-admin-jwt-secret>
ADMIN_BOOTSTRAP_PASSWORD=<set-admin-bootstrap-password>
PARTNER_API_KEY=<set-partner-api-key>
AFRICASTALKING_LOG_RAW_TOKEN=false

# Firebase
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_BASE64=

# Media / MinIO
MEDIA_STORAGE_ENDPOINT=http://minio:9000
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_ACCESS_KEY=<set-media-access-key>
MEDIA_STORAGE_SECRET_KEY=<set-media-secret-key>
MINIO_URL=http://minio:9000
MINIO_USER=<set-minio-user>
MINIO_PASSWORD=<set-minio-password>
MINIO_BUCKET_NAME=cc-media-public
MEDIA_STORAGE_PATH_STYLE=true
MEDIA_BUCKET_PUBLIC=cc-media-public
MEDIA_BUCKET_PRIVATE=cc-media-private
MEDIA_BUCKET_KYC=cc-media-kyc
MEDIA_BUCKET_AUTO_CREATE=true
MEDIA_STORAGE_STARTUP_STRICT=false
MEDIA_UPLOAD_URL_TTL_MINUTES=15
MEDIA_DOWNLOAD_URL_TTL_MINUTES=15
MEDIA_MAX_SIZE_BYTES=10485760

# Prod
HOST_PORT_PROD=9901
DATABASE_PORT_PROD=5432
DATABASE_URL_PROD=postgres-prod-host
DATABASE_USER_PROD=cc_app
DATABASE_PASSWORD_PROD=<set-strong-db-password>
DATABASE_NAME_PROD=cc_app_db

# Integrations
MAIL_PASSWORD=<set-mail-password>
SENTRY_DSN=<set-sentry-dsn>
ACTIVEMQ_USER=<set-activemq-user>
ACTIVEMQ_PASSWORD=<set-activemq-password>

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_CCAPP=DEBUG
HTTP_TRACE_ENABLED=true
HTTP_TRACE_MAX_PAYLOAD_LENGTH=4000
HTTP_TRACE_LOG_AUTH_TOKEN=true
HTTP_TRACE_LOG_API_KEY=true
