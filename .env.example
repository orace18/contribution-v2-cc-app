# Shared container metadata
IMAGE_FULL=registry.gitlab.com/your-group/cc-app-backend:latest
CI_PROJECT_NAME=cc-app-backend
API_DOMAIN=api.example.com

# Dev
APP_PORT=8080
DATABASE_URL=postgres-host
DATABASE_USER=cc_app
DATABASE_PASSWORD=cc_app_pass
DATABASE_NAME=cc_app_db

# Security
INTERNAL_API_KEY=change-me
JAWUPAY_HMAC_SECRET=change-me

# Firebase
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/opt/app/secrets/firebase-service-account-prod.json

# Prod
HOST_PORT_PROD=9901
DATABASE_PORT_PROD=5432
DATABASE_URL_PROD=postgres-prod-host
DATABASE_USER_PROD=cc_app
DATABASE_PASSWORD_PROD=change-me
DATABASE_NAME_PROD=cc_app_db

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_CCAPP=DEBUG
