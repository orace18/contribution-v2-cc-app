FROM eclipse-temurin:21-jre
ARG WORK_DIRECTORY=/home/owomi
ARG APP_NAME=cc-app-backend.jar
ARG APP_LINK=cc-app-backend-0.0.1-SNAPSHOT.jar
ARG APP_PORT=8081
ENV ENV_APP_NAME=${APP_NAME}
ENV JAVA_OPTS='-Xmx512m -Xms256m'
WORKDIR ${WORK_DIRECTORY}
ADD ${APP_LINK} ${WORK_DIRECTORY}/${APP_NAME}
EXPOSE ${APP_PORT}
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar -DSPRING_CONFIG_LOCATION=$APP_CONFIG_DIRECTORY $ENV_APP_NAME"]